    <script>
        (async function detectIPVersion() {
            try {
                const response = await fetch('https://api64.ipify.org?format=json');
                const data = await response.json();
                const ip = data.ip;
                const ipType = ip.includes(':') ? 'IPv6' : 'IPv4';
                document.getElementById('ip-info').textContent =
                    `Your IP is ${ip} and it is ${ipType}.`;
            } catch (err) {
                document.getElementById('ip-info').textContent =
                    'Unable to detect IP version.';
                console.error('IP detection error:', err);
            }
        })();
</script>
</body>
