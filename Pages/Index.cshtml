@page
@model IndexModel
@{    
    ViewData["Title"] = "Home page";
}
<div class="text-center">
<h1 class="display-4">Hallo Hanan das ist meine Homepage</h1>
<p>Learn about <a href="https://docs.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
<hr />
<div>Host operating system: @Model.OSVersion</div>
</div>
 
<p id="ip-info">Checking your IP version…</p>
 
<script>
document.addEventListener("DOMContentLoaded", async function() {
    const ipInfo = document.getElementById("ip-info");
 
    try {
        // Ruft die öffentliche IP ab
        const response = await fetch("https://api64.ipify.org?format=json");
        if (!response.ok) throw new Error("Network response not ok");
 
        const data = await response.json();
        const ip = data.ip;
 
        // Prüfen, ob IPv6 (enthält ':') oder IPv4
        const ipType = ip.includes(":") ? "IPv6" : "IPv4";
 
        ipInfo.textContent = `Your IP is ${ip} and it is ${ipType}.`;
    } catch (err) {
        ipInfo.textContent = "Unable to detect IP version.";
        console.error("IP detection error:", err);
    }
});
</script>
